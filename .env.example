# Konfigurasi WhatsApp Google Drive Bot

# ID Folder tujuan di Google Drive (Dapat diambil dari URL Google Drive: https://drive.google.com/drive/folders/[FOLDER_ID])
# Kosongkan jika ingin di-upload ke Root My Drive
GOOGLE_DRIVE_FOLDER_ID=

# Buat sub-folder otomatis berdasarkan tanggal (true/false)
# Jika true, bot akan membuat folder 'YYYY-MM-DD' di dalam folder tujuan
AUTO_DATE_FOLDER=true

# Nomor WhatsApp Pemilik/Admin (Owner) yang memiliki hak akses penuh
# Format internasional tanpa simbol '+' (contoh: 6281234567890,6289876543210)
OWNER_NUMBERS=6281234567890

# Nomor WhatsApp yang diizinkan untuk upload (whitelist)
# Format internasional tanpa simbol '+' (contoh: 6281234567890,6289876543210)
# Isi '*' untuk mengizinkan semua nomor, atau isi nomor Anda sendiri
ALLOWED_NUMBERS=*

# Batas maksimal ukuran file dalam Megabyte (MB)
# WhatsApp mendukung dokumen hingga 2000 MB (2 GB)
MAX_FILE_SIZE_MB=2000
